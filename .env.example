# ==============================================================================
# MealRelay Workspace Root Environment Template
# ==============================================================================
# MealRelay is structured as a full-stack monorepo with distinct frontend
# and backend configurations:
#
# 1. Backend Service (`server/`):
#    Copy `server/.env.example` -> `server/.env`
#    Controls: Port, database connection (PostgreSQL / Neon), JWT secrets, and CORS.
#
# 2. Frontend Client (`client/`):
#    Copy `client/.env.example` -> `client/.env`
#    Controls: Public REST API endpoint (`VITE_API_BASE_URL`).
#
# Neon setup: `neon deploy` writes DATABASE_URL and DATABASE_URL_UNPOOLED to
# the root .env or .env.local. The backend and Prisma scripts load these files.
# Precedence: process env > server/.env.test (tests only) > server/.env.local >
# root .env.local > server/.env > root .env.
# Below is a quick unified summary for single-file development environments:
# ==============================================================================

# --- Backend Configuration (server/.env) ---
PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/mealrelay?schema=public"
# Neon supplies a direct connection for migrations. Local PostgreSQL can use
# the same URL for both (the loader defaults this to DATABASE_URL if omitted).
DATABASE_URL_UNPOOLED="postgresql://postgres:your_password@localhost:5432/mealrelay?schema=public"
TEST_DATABASE_URL="postgresql://postgres:your_password@localhost:5432/mealrelay_test?schema=public"
JWT_SECRET="dev-mealrelay-jwt-secret-key-32chars-minimum-needed!"
JWT_EXPIRES_IN="7d"
CLIENT_URL="http://localhost:5173"
ADMIN_EMAIL="admin@mealrelay.org"
ADMIN_BOOTSTRAP_SECRET="dev-bootstrap-secret-change-in-production!"

# --- Frontend Configuration (client/.env) ---
VITE_API_BASE_URL="http://localhost:5000/api"
