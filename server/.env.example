# ==============================================================================
# MealRelay Backend Environment Configuration Reference
# ==============================================================================
# Usage:
#   Local Dev: Copy this file to `server/.env` and adjust credentials as needed.
#   Production: Configure these environment variables in your hosting provider
#               dashboard (e.g., Render Web Service Environment Variables).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Runtime & Network
# ------------------------------------------------------------------------------

# PORT
# Scope: Backend-only (Private)
# Required: No (defaults to 5000 locally; Render automatically injects PORT in production)
# Controls: The network port Express listens on (bound to 0.0.0.0).
# Production Location: Render automatically manages this; do not hardcode unless required.
PORT=5000

# NODE_ENV
# Scope: Backend-only (Private)
# Required: Yes
# Controls: Runtime environment behavior. When set to 'production', stack traces
#           are suppressed in API responses, security checks are enforced, and
#           HSTS headers are activated.
# Values: 'development' | 'production' | 'test'
# Production Location: Render Environment Variables -> set to 'production'.
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Database Connections (PostgreSQL / Neon)
# ------------------------------------------------------------------------------

# DATABASE_URL
# Scope: Backend-only (Private, Sensitive)
# Required: Yes
# Controls: The PostgreSQL connection string used by Prisma ORM for data storage,
#           pooling, and schema migrations.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Production Location: Render Environment Variables. Use your Neon PostgreSQL pooled
#                      connection string with `sslmode=require`.
DATABASE_URL="postgresql://postgres:your_local_password@localhost:5432/mealrelay?schema=public"
# Direct connection used by Prisma Migrate. Neon deploy supplies this in the
# workspace .env.local; omit here to use those values. For local PostgreSQL,
# it defaults to DATABASE_URL when not set anywhere.
# DATABASE_URL_UNPOOLED="postgresql://postgres:your_local_password@localhost:5432/mealrelay?schema=public"

# TEST_DATABASE_URL
# Scope: Backend-only (Private, Local Only)
# Required: Yes (for running local test suite: `npm run test`)
# Controls: Isolated test database used by Vitest and Supertest integration tests.
#           Prevents tests from clearing development or production data.
# Production Location: Not required in production environments.
TEST_DATABASE_URL="postgresql://postgres:your_local_password@localhost:5432/mealrelay_test?schema=public"

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------

# JWT_SECRET
# Scope: Backend-only (Private, Sensitive)
# Required: Yes (strictly validated at startup in production; fallback rejected)
# Controls: Cryptographic HMAC key used to sign and verify JSON Web Tokens (JWT).
#           Must be a secure, random string at least 32 characters long.
# Production Location: Render Environment Variables. Generate via: `openssl rand -hex 32`
JWT_SECRET="replace-with-a-secure-random-32-plus-character-secret-key"

# JWT_EXPIRES_IN
# Scope: Backend-only (Private)
# Required: No (defaults to '7d')
# Controls: Expiration duration for signed session tokens (e.g., '1d', '7d', '24h').
# Production Location: Render Environment Variables.
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 4. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------

# CLIENT_URL
# Scope: Backend-only (Private)
# Required: Yes (in production)
# Controls: Allowed frontend origin(s) permitted to make cross-origin API requests.
#           Can be a single origin or a comma-separated list of origins.
#           Omit trailing slashes.
# Example: https://mealrelay.vercel.app,https://mealrelay-preview.vercel.app
# Production Location: Render Environment Variables -> set to your Vercel app domain.
CLIENT_URL="http://localhost:5173"

# ------------------------------------------------------------------------------
# 5. Administrative Access & One-Time Bootstrap
# ------------------------------------------------------------------------------

# ADMIN_EMAIL
# Scope: Backend-only (Private, Sensitive)
# Required: For initial administrator account provisioning via POST /api/admin/bootstrap
# Controls: The designated administrator email address authorized to claim or initialize
#           the primary platform administrator account.
# Production Location: Render Environment Variables -> set to your admin email address.
ADMIN_EMAIL="admin@mealrelay.org"

# ADMIN_BOOTSTRAP_SECRET
# Scope: Backend-only (Private, Highly Sensitive)
# Required: For initial administrator account provisioning via POST /api/admin/bootstrap
# Controls: High-entropy secret key required to authenticate the one-time admin bootstrap.
#           Must never be prefixed with VITE_ or exposed to the client.
# Production Location: Render Environment Variables. Generate via: `openssl rand -hex 32`
ADMIN_BOOTSTRAP_SECRET="replace-with-a-secure-random-32-plus-character-secret"

